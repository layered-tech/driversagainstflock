<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Scene backgroundColor="#000000">
        <PartText x="90" y="34" width="270" height="30">
            <Text><Font family="SYNC_TO_DEVICE" size="22" color="#1FBF6B">DAF · DEBUG FACE</Font></Text>
        </PartText>
        <DigitalClock x="125" y="66" width="200" height="50">
            <TimeText x="0" y="0" width="200" height="50" format="hh:mm">
                <Font family="SYNC_TO_DEVICE" size="40" color="#FFFFFF" />
            </TimeText>
        </DigitalClock>

        <PartText x="68" y="126" width="140" height="28">
            <Text><Font family="SYNC_TO_DEVICE" size="22" color="#B3B3B3">Short text</Font></Text>
        </PartText>
        <ComplicationSlot slotId="1" displayName="short_text" x="68" y="158" width="140" height="100" supportedTypes="SHORT_TEXT EMPTY">
            <BoundingRoundBox x="0" y="0" width="140" height="100" cornerRadius="16" />
            <DefaultProviderPolicy primaryProvider="com.anonymous.drivefree/org.driversagainstflock.watch.WatchComplicationService" primaryProviderType="SHORT_TEXT"
                secondaryProvider="com.anonymous.drivefree.dev/org.driversagainstflock.watch.WatchComplicationService" secondaryProviderType="SHORT_TEXT"
                defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="140" height="100">
                    <Text><Font family="SYNC_TO_DEVICE" size="40" color="#FFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="0" width="140" height="100">
                    <Text><Font family="SYNC_TO_DEVICE" size="22" color="#B3B3B3">Select DAF</Font></Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <PartText x="242" y="126" width="140" height="28">
            <Text><Font family="SYNC_TO_DEVICE" size="22" color="#B3B3B3">Ranged value</Font></Text>
        </PartText>
        <ComplicationSlot slotId="2" displayName="ranged_value" x="242" y="158" width="140" height="100" supportedTypes="RANGED_VALUE EMPTY">
            <BoundingRoundBox x="0" y="0" width="140" height="100" cornerRadius="16" />
            <DefaultProviderPolicy primaryProvider="com.anonymous.drivefree/org.driversagainstflock.watch.WatchPrivacyScoreComplicationService" primaryProviderType="RANGED_VALUE"
                secondaryProvider="com.anonymous.drivefree.dev/org.driversagainstflock.watch.WatchPrivacyScoreComplicationService" secondaryProviderType="RANGED_VALUE"
                defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="RANGED_VALUE">
                <PartDraw x="30" y="10" width="80" height="80">
                    <Arc centerX="40" centerY="40" width="80" height="80" startAngle="-150" endAngle="150">
                        <Stroke thickness="6" color="#1F1F1F" cap="ROUND" />
                    </Arc>
                </PartDraw>
                <PartDraw x="30" y="10" width="80" height="80" alpha="0">
                    <Transform target="alpha" value="[COMPLICATION.RANGED_VALUE_VALUE] &gt; [COMPLICATION.RANGED_VALUE_MIN] ? 255 : 0" />
                    <Arc centerX="40" centerY="40" width="80" height="80" startAngle="-150" endAngle="-150">
                        <Stroke thickness="6" color="#1FBF6B" cap="ROUND" />
                        <Transform target="endAngle" value="-150 + 300 * clamp(([COMPLICATION.RANGED_VALUE_VALUE] - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] &gt; [COMPLICATION.RANGED_VALUE_MIN] ? [COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN] : 1), 0, 1)" />
                    </Arc>
                </PartDraw>
                <PartText x="0" y="10" width="140" height="80">
                    <Text><Font family="SYNC_TO_DEVICE" size="32" color="#FFFFFF"><Template>%.0f<Parameter expression="[COMPLICATION.RANGED_VALUE_VALUE]" /></Template></Font></Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="0" width="140" height="100">
                    <Text><Font family="SYNC_TO_DEVICE" size="22" color="#B3B3B3">Select DAF</Font></Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <PartText x="75" y="264" width="300" height="28">
            <Text><Font family="SYNC_TO_DEVICE" size="22" color="#B3B3B3">Long text</Font></Text>
        </PartText>
        <ComplicationSlot slotId="3" displayName="long_text" x="75" y="296" width="300" height="50" supportedTypes="LONG_TEXT EMPTY">
            <BoundingRoundBox x="0" y="0" width="300" height="50" cornerRadius="16" />
            <DefaultProviderPolicy primaryProvider="com.anonymous.drivefree/org.driversagainstflock.watch.WatchComplicationService" primaryProviderType="LONG_TEXT"
                secondaryProvider="com.anonymous.drivefree.dev/org.driversagainstflock.watch.WatchComplicationService" secondaryProviderType="LONG_TEXT"
                defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="LONG_TEXT">
                <PartText x="0" y="0" width="300" height="50">
                    <Text ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="26" color="#FFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="0" width="300" height="50">
                    <Text><Font family="SYNC_TO_DEVICE" size="22" color="#B3B3B3">Select DAF</Font></Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <PartText x="175" y="350" width="100" height="28">
            <Text><Font family="SYNC_TO_DEVICE" size="22" color="#B3B3B3">Icon</Font></Text>
        </PartText>
        <ComplicationSlot slotId="4" displayName="icon" x="175" y="382" width="100" height="44" supportedTypes="MONOCHROMATIC_IMAGE EMPTY">
            <BoundingRoundBox x="0" y="0" width="100" height="44" cornerRadius="16" />
            <DefaultProviderPolicy primaryProvider="com.anonymous.drivefree/org.driversagainstflock.watch.WatchOpenCompanionComplicationService" primaryProviderType="MONOCHROMATIC_IMAGE"
                secondaryProvider="com.anonymous.drivefree.dev/org.driversagainstflock.watch.WatchOpenCompanionComplicationService" secondaryProviderType="MONOCHROMATIC_IMAGE"
                defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="28" y="0" width="44" height="44" tintColor="#FFFFFF">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="0" width="100" height="44">
                    <Text><Font family="SYNC_TO_DEVICE" size="20" color="#B3B3B3">Select DAF</Font></Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
