{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ManageOsmLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:DeleteLogGroup",
                "logs:DeleteLogStream",
                "logs:DescribeLogStreams",
                "logs:ListTagsForResource",
                "logs:PutLogEvents",
                "logs:PutRetentionPolicy",
                "logs:TagResource",
                "logs:UntagResource"
            ],
            "Resource": "arn:aws:logs:us-east-1:326364278889:log-group:/daf-osm/*"
        },
        {
            "Sid": "ReadOsmLogGroups",
            "Effect": "Allow",
            "Action": "logs:DescribeLogGroups",
            "Resource": "*"
        },
        {
            "Sid": "ManageOsmAlarms",
            "Effect": "Allow",
            "Action": [
                "cloudwatch:DeleteAlarms",
                "cloudwatch:DescribeAlarms",
                "cloudwatch:ListTagsForResource",
                "cloudwatch:PutMetricAlarm",
                "cloudwatch:TagResource",
                "cloudwatch:UntagResource"
            ],
            "Resource": "arn:aws:cloudwatch:us-east-1:326364278889:alarm:daf-osm-*"
        },
        {
            "Sid": "ManageOsmDashboard",
            "Effect": "Allow",
            "Action": [
                "cloudwatch:DeleteDashboards",
                "cloudwatch:GetDashboard",
                "cloudwatch:PutDashboard"
            ],
            "Resource": "arn:aws:cloudwatch::326364278889:dashboard/daf-osm"
        },
        {
            "Sid": "ListOsmDashboards",
            "Effect": "Allow",
            "Action": "cloudwatch:ListDashboards",
            "Resource": "*"
        },
        {
            "Sid": "ManageOsmMetrics",
            "Effect": "Allow",
            "Action": "cloudwatch:PutMetricData",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "cloudwatch:namespace": "DAF/OSM"
                }
            }
        },
        {
            "Sid": "ReadOsmMetrics",
            "Effect": "Allow",
            "Action": [
                "cloudwatch:GetMetricData",
                "cloudwatch:GetMetricStatistics",
                "cloudwatch:ListMetrics"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ManageOsmNotifications",
            "Effect": "Allow",
            "Action": [
                "sns:CreateTopic",
                "sns:DeleteTopic",
                "sns:GetTopicAttributes",
                "sns:ListSubscriptionsByTopic",
                "sns:ListTagsForResource",
                "sns:SetTopicAttributes",
                "sns:Subscribe",
                "sns:TagResource",
                "sns:UntagResource"
            ],
            "Resource": "arn:aws:sns:us-east-1:326364278889:daf-osm-*"
        },
        {
            "Sid": "ManageOsmSubscriptions",
            "Effect": "Allow",
            "Action": [
                "sns:GetSubscriptionAttributes",
                "sns:Unsubscribe"
            ],
            "Resource": "arn:aws:sns:us-east-1:326364278889:daf-osm-*"
        },
        {
            "Sid": "ManageOsmBudgets",
            "Effect": "Allow",
            "Action": [
                "budgets:ListTagsForResource",
                "budgets:ModifyBudget",
                "budgets:TagResource",
                "budgets:UntagResource",
                "budgets:ViewBudget"
            ],
            "Resource": "arn:aws:budgets::326364278889:budget/daf-osm-*"
        },
        {
            "Sid": "ReadCostAllocationTags",
            "Effect": "Allow",
            "Action": "ce:ListCostAllocationTags",
            "Resource": "*"
        },
        {
            "Sid": "CreateTaggedOsmAnomalyResources",
            "Effect": "Allow",
            "Action": [
                "ce:CreateAnomalyMonitor",
                "ce:CreateAnomalySubscription",
                "ce:TagResource"
            ],
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestTag/Project": "daf-osm"
                },
                "ForAllValues:StringEquals": {
                    "aws:TagKeys": [
                        "Environment",
                        "ManagedBy",
                        "Name",
                        "Project"
                    ]
                }
            }
        },
        {
            "Sid": "ManageTaggedOsmAnomalyResources",
            "Effect": "Allow",
            "Action": [
                "ce:DeleteAnomalyMonitor",
                "ce:DeleteAnomalySubscription",
                "ce:GetAnomalyMonitors",
                "ce:GetAnomalySubscriptions",
                "ce:ListTagsForResource",
                "ce:TagResource",
                "ce:UntagResource",
                "ce:UpdateAnomalyMonitor",
                "ce:UpdateAnomalySubscription"
            ],
            "Resource": [
                "arn:aws:ce::326364278889:anomalymonitor/*",
                "arn:aws:ce::326364278889:anomalysubscription/*"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/Project": "daf-osm"
                }
            }
        }
    ]
}
