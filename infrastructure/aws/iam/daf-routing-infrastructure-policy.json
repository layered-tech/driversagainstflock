{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadInfrastructure",
            "Effect": "Allow",
            "Action": [
                "ec2:Describe*",
                "ec2:GetEbsDefaultKmsKeyId",
                "ec2:GetEbsEncryptionByDefault",
                "iam:GetAccountSummary",
                "iam:GetPolicy",
                "iam:GetPolicyVersion",
                "iam:ListInstanceProfiles",
                "iam:ListPolicies",
                "iam:ListRoles",
                "kms:DescribeKey",
                "kms:ListAliases",
                "servicequotas:GetServiceQuota",
                "servicequotas:ListServiceQuotas"
            ],
            "Resource": "*"
        },
        {
            "Sid": "CreateTaggedRoutingResources",
            "Effect": "Allow",
            "Action": [
                "ec2:AllocateAddress",
                "ec2:CreateLaunchTemplate",
                "ec2:CreateNatGateway",
                "ec2:CreateNetworkInterface",
                "ec2:CreateRouteTable",
                "ec2:CreateSecurityGroup",
                "ec2:CreateSubnet",
                "ec2:CreateVolume",
                "ec2:RunInstances"
            ],
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestedRegion": "us-east-1",
                    "aws:RequestTag/Project": "daf-routing"
                }
            }
        },
        {
            "Sid": "UseNetwork",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateNatGateway",
                "ec2:CreateRouteTable",
                "ec2:CreateSecurityGroup",
                "ec2:CreateSubnet"
            ],
            "Resource": [
                "arn:aws:ec2:us-east-1:326364278889:subnet/subnet-0aec59f0da18b6c9c",
                "arn:aws:ec2:us-east-1:326364278889:vpc/vpc-0ca7765532da9cf89"
            ],
            "Condition": {
                "StringEquals": {
                    "aws:RequestedRegion": "us-east-1"
                }
            }
        },
        {
            "Sid": "UseRoutingEip",
            "Effect": "Allow",
            "Action": "ec2:CreateNatGateway",
            "Resource": "arn:aws:ec2:us-east-1:326364278889:elastic-ip/*",
            "Condition": {
                "StringEquals": {
                    "ec2:ResourceTag/Project": "daf-routing"
                }
            }
        },
        {
            "Sid": "UseRoutingNetwork",
            "Effect": "Allow",
            "Action": [
                "ec2:CreateNetworkInterface",
                "ec2:RunInstances"
            ],
            "Resource": [
                "arn:aws:ec2:us-east-1:326364278889:network-interface/*",
                "arn:aws:ec2:us-east-1:326364278889:security-group/*",
                "arn:aws:ec2:us-east-1:326364278889:subnet/*"
            ],
            "Condition": {
                "StringEquals": {
                    "ec2:ResourceTag/Project": "daf-routing"
                }
            }
        },
        {
            "Sid": "UseLinuxImage",
            "Effect": "Allow",
            "Action": "ec2:RunInstances",
            "Resource": "arn:aws:ec2:us-east-1::image/ami-*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestedRegion": "us-east-1"
                }
            }
        },
        {
            "Sid": "TagResourcesDuringCreation",
            "Effect": "Allow",
            "Action": "ec2:CreateTags",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestedRegion": "us-east-1",
                    "ec2:CreateAction": [
                        "AllocateAddress",
                        "CreateLaunchTemplate",
                        "CreateNatGateway",
                        "CreateNetworkInterface",
                        "CreateRouteTable",
                        "CreateSecurityGroup",
                        "CreateSubnet",
                        "CreateVolume",
                        "RunInstances"
                    ]
                },
                "ForAllValues:StringEquals": {
                    "aws:TagKeys": [
                        "Environment",
                        "ManagedBy",
                        "Name",
                        "Project"
                    ]
                }
            }
        },
        {
            "Sid": "ManageTaggedRoutingResources",
            "Effect": "Allow",
            "Action": [
                "ec2:AssociateIamInstanceProfile",
                "ec2:AssociateRouteTable",
                "ec2:AttachNetworkInterface",
                "ec2:AttachVolume",
                "ec2:AuthorizeSecurityGroupEgress",
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:CreateLaunchTemplateVersion",
                "ec2:CreateRoute",
                "ec2:CreateTags",
                "ec2:DeleteLaunchTemplate",
                "ec2:DeleteLaunchTemplateVersions",
                "ec2:DeleteNatGateway",
                "ec2:DeleteNetworkInterface",
                "ec2:DeleteRoute",
                "ec2:DeleteRouteTable",
                "ec2:DeleteSecurityGroup",
                "ec2:DeleteSubnet",
                "ec2:DeleteTags",
                "ec2:DeleteVolume",
                "ec2:DetachNetworkInterface",
                "ec2:DetachVolume",
                "ec2:DisassociateIamInstanceProfile",
                "ec2:DisassociateRouteTable",
                "ec2:ModifyInstanceAttribute",
                "ec2:ModifyLaunchTemplate",
                "ec2:ModifyNetworkInterfaceAttribute",
                "ec2:ModifySecurityGroupRules",
                "ec2:ModifySubnetAttribute",
                "ec2:ModifyVolume",
                "ec2:ReleaseAddress",
                "ec2:ReplaceIamInstanceProfileAssociation",
                "ec2:ReplaceRoute",
                "ec2:ReplaceRouteTableAssociation",
                "ec2:RevokeSecurityGroupEgress",
                "ec2:RevokeSecurityGroupIngress",
                "ec2:StartInstances",
                "ec2:StopInstances",
                "ec2:TerminateInstances"
            ],
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestedRegion": "us-east-1",
                    "ec2:ResourceTag/Project": "daf-routing"
                }
            }
        },
        {
            "Sid": "EnableVpcPrivateDns",
            "Effect": "Allow",
            "Action": "ec2:ModifyVpcAttribute",
            "Resource": "arn:aws:ec2:us-east-1:326364278889:vpc/vpc-0ca7765532da9cf89"
        },
        {
            "Sid": "CreateRoutingRolesWithBoundary",
            "Effect": "Allow",
            "Action": "iam:CreateRole",
            "Resource": "arn:aws:iam::326364278889:role/daf-routing-*",
            "Condition": {
                "StringEquals": {
                    "iam:PermissionsBoundary": "arn:aws:iam::326364278889:policy/DafRoutingWorkloadBoundary"
                }
            }
        },
        {
            "Sid": "ManageBoundedRoutingRoles",
            "Effect": "Allow",
            "Action": [
                "iam:AddRoleToInstanceProfile",
                "iam:CreateInstanceProfile",
                "iam:DeleteInstanceProfile",
                "iam:DeleteRole",
                "iam:DeleteRolePolicy",
                "iam:GetInstanceProfile",
                "iam:GetRole",
                "iam:GetRolePolicy",
                "iam:ListAttachedRolePolicies",
                "iam:ListInstanceProfilesForRole",
                "iam:ListRolePolicies",
                "iam:PutRolePolicy",
                "iam:RemoveRoleFromInstanceProfile",
                "iam:TagInstanceProfile",
                "iam:TagRole",
                "iam:UntagInstanceProfile",
                "iam:UntagRole",
                "iam:UpdateAssumeRolePolicy",
                "iam:UpdateRoleDescription"
            ],
            "Resource": [
                "arn:aws:iam::326364278889:instance-profile/daf-routing-*",
                "arn:aws:iam::326364278889:role/daf-routing-*"
            ]
        },
        {
            "Sid": "PassRoutingRolesOnlyToEc2",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::326364278889:role/daf-routing-*",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "ec2.amazonaws.com"
                }
            }
        },
        {
            "Sid": "CreateBudgetsServiceRole",
            "Effect": "Allow",
            "Action": "iam:CreateServiceLinkedRole",
            "Resource": "arn:aws:iam::326364278889:role/aws-service-role/budgets.amazonaws.com/*",
            "Condition": {
                "StringEquals": {
                    "iam:AWSServiceName": "budgets.amazonaws.com"
                }
            }
        },
        {
            "Sid": "ProtectMoonlitCloud",
            "Effect": "Deny",
            "Action": [
                "ec2:ModifyInstanceAttribute",
                "ec2:RebootInstances",
                "ec2:StartInstances",
                "ec2:StopInstances",
                "ec2:TerminateInstances"
            ],
            "Resource": "arn:aws:ec2:us-east-1:326364278889:instance/i-0b983523680d2bf7d"
        },
        {
            "Sid": "ProtectExistingPublicNetwork",
            "Effect": "Deny",
            "Action": [
                "ec2:AuthorizeSecurityGroupEgress",
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:CreateRoute",
                "ec2:DeleteInternetGateway",
                "ec2:DeleteRoute",
                "ec2:DeleteRouteTable",
                "ec2:DeleteSecurityGroup",
                "ec2:DeleteSubnet",
                "ec2:DetachInternetGateway",
                "ec2:DisassociateRouteTable",
                "ec2:ModifySecurityGroupRules",
                "ec2:ModifySubnetAttribute",
                "ec2:ReplaceRoute",
                "ec2:ReplaceRouteTableAssociation",
                "ec2:RevokeSecurityGroupEgress",
                "ec2:RevokeSecurityGroupIngress"
            ],
            "Resource": [
                "arn:aws:ec2:us-east-1:326364278889:internet-gateway/igw-07923c83d382676c2",
                "arn:aws:ec2:us-east-1:326364278889:route-table/rtb-09c13b6fad4fbc07b",
                "arn:aws:ec2:us-east-1:326364278889:security-group/sg-0a4ca901836e1b34b",
                "arn:aws:ec2:us-east-1:326364278889:subnet/subnet-0aec59f0da18b6c9c"
            ]
        }
    ]
}
