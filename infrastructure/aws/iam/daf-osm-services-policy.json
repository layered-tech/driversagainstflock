{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ManageOsmBuckets",
            "Effect": "Allow",
            "Action": [
                "s3:CreateBucket",
                "s3:DeleteBucket",
                "s3:GetAccelerateConfiguration",
                "s3:GetBucket*",
                "s3:GetEncryptionConfiguration",
                "s3:GetLifecycleConfiguration",
                "s3:GetReplicationConfiguration",
                "s3:ListBucket",
                "s3:ListBucketVersions",
                "s3:PutBucketOwnershipControls",
                "s3:PutBucketPolicy",
                "s3:PutBucketPublicAccessBlock",
                "s3:PutBucketTagging",
                "s3:PutBucketVersioning",
                "s3:PutEncryptionConfiguration",
                "s3:PutLifecycleConfiguration"
            ],
            "Resource": [
                "arn:aws:s3:::daf-osm-artifacts-326364278889-us-east-1",
                "arn:aws:s3:::daf-osm-backups-326364278889-us-east-1"
            ]
        },
        {
            "Sid": "ManageOsmBucketObjects",
            "Effect": "Allow",
            "Action": [
                "s3:AbortMultipartUpload",
                "s3:DeleteObject",
                "s3:DeleteObjectVersion",
                "s3:GetObject",
                "s3:GetObjectTagging",
                "s3:GetObjectVersion",
                "s3:ListMultipartUploadParts",
                "s3:PutObject",
                "s3:PutObjectTagging"
            ],
            "Resource": [
                "arn:aws:s3:::daf-osm-artifacts-326364278889-us-east-1/*",
                "arn:aws:s3:::daf-osm-backups-326364278889-us-east-1/*"
            ]
        },
        {
            "Sid": "ReadDns",
            "Effect": "Allow",
            "Action": [
                "route53:GetChange",
                "route53:GetHostedZone",
                "route53:ListHostedZones",
                "route53:ListHostedZonesByVPC",
                "route53:ListResourceRecordSets",
                "route53:ListTagsForResource"
            ],
            "Resource": "*"
        },
        {
            "Sid": "CreateOsmPrivateHostedZone",
            "Effect": "Allow",
            "Action": "route53:CreateHostedZone",
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "route53:VPCs": "VPCId=vpc-0ca7765532da9cf89,VPCRegion=us-east-1"
                }
            }
        },
        {
            "Sid": "TagOsmHostedZones",
            "Effect": "Allow",
            "Action": "route53:ChangeTagsForResource",
            "Resource": "arn:aws:route53:::hostedzone/*"
        },
        {
            "Sid": "ManageOsmPrivateHostedZones",
            "Effect": "Allow",
            "Action": [
                "route53:AssociateVPCWithHostedZone",
                "route53:DeleteHostedZone",
                "route53:DisassociateVPCFromHostedZone"
            ],
            "Resource": "arn:aws:route53:::hostedzone/*"
        },
        {
            "Sid": "ManageOsmDatabaseRecord",
            "Effect": "Allow",
            "Action": "route53:ChangeResourceRecordSets",
            "Resource": "arn:aws:route53:::hostedzone/*",
            "Condition": {
                "ForAllValues:StringEquals": {
                    "route53:ChangeResourceRecordSetsActions": [
                        "CREATE",
                        "DELETE",
                        "UPSERT"
                    ],
                    "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
                        "database.daf-osm.internal"
                    ],
                    "route53:ChangeResourceRecordSetsRecordTypes": [
                        "A"
                    ]
                }
            }
        },
        {
            "Sid": "ProtectExistingPublicHostedZone",
            "Effect": "Deny",
            "Action": [
                "route53:AssociateVPCWithHostedZone",
                "route53:ChangeResourceRecordSets",
                "route53:ChangeTagsForResource",
                "route53:DeleteHostedZone",
                "route53:DisassociateVPCFromHostedZone"
            ],
            "Resource": "arn:aws:route53:::hostedzone/Z06275341CPJ6OSABH1X6"
        },
        {
            "Sid": "ManageOsmParameters",
            "Effect": "Allow",
            "Action": [
                "ssm:AddTagsToResource",
                "ssm:DeleteParameter",
                "ssm:GetParameter",
                "ssm:GetParameters",
                "ssm:ListTagsForResource",
                "ssm:PutParameter",
                "ssm:RemoveTagsFromResource"
            ],
            "Resource": "arn:aws:ssm:us-east-1:326364278889:parameter/daf-osm/*"
        },
        {
            "Sid": "ReadOsmParameterMetadata",
            "Effect": "Allow",
            "Action": "ssm:DescribeParameters",
            "Resource": "*"
        },
        {
            "Sid": "ReadAmazonLinuxAmiParameter",
            "Effect": "Allow",
            "Action": "ssm:GetParameter",
            "Resource": "arn:aws:ssm:us-east-1::parameter/aws/service/ami-amazon-linux-latest/*"
        },
        {
            "Sid": "SendShellCommands",
            "Effect": "Allow",
            "Action": "ssm:SendCommand",
            "Resource": "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
        },
        {
            "Sid": "TargetOsmInstances",
            "Effect": "Allow",
            "Action": [
                "ssm:SendCommand",
                "ssm:StartSession"
            ],
            "Resource": "arn:aws:ec2:us-east-1:326364278889:instance/*",
            "Condition": {
                "StringEquals": {
                    "ssm:resourceTag/Project": "daf-osm"
                }
            }
        },
        {
            "Sid": "UseSessionDocuments",
            "Effect": "Allow",
            "Action": "ssm:StartSession",
            "Resource": [
                "arn:aws:ssm:us-east-1::document/AWS-StartPortForwardingSession",
                "arn:aws:ssm:us-east-1::document/AWS-StartPortForwardingSessionToRemoteHost"
            ]
        },
        {
            "Sid": "InspectAndControlOwnCommands",
            "Effect": "Allow",
            "Action": [
                "ssm:CancelCommand",
                "ssm:DescribeInstanceInformation",
                "ssm:GetCommandInvocation",
                "ssm:ListCommandInvocations",
                "ssm:ListCommands"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ControlOwnSessions",
            "Effect": "Allow",
            "Action": [
                "ssm:ResumeSession",
                "ssm:TerminateSession"
            ],
            "Resource": "arn:aws:ssm:*:326364278889:session/${aws:username}-*"
        }
    ]
}
