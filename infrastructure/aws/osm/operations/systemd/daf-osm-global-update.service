[Unit]
Description=Acquire and apply one global OSM minute feed
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=osm_ingest
Group=osm_ingest
EnvironmentFile=/etc/daf-osm/daf-osm.env
RuntimeDirectory=daf-osm
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/flock --nonblock /run/daf-osm/global.lock /opt/daf-osm/bin/global-update.sh
TimeoutStartSec=50min
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=append:/var/log/daf-osm/global-update.log
StandardError=append:/var/log/daf-osm/global-update.log
