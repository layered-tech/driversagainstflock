[Unit]
Description=Initialize the shared global OSM feed after both bootstraps
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=osm_ingest
Group=osm_ingest
EnvironmentFile=/etc/daf-osm/daf-osm.env
RuntimeDirectory=daf-osm
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/flock --nonblock /run/daf-osm/global.lock /opt/daf-osm/bin/initialize-global-stack.sh
TimeoutStartSec=10min
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=append:/var/log/daf-osm/global-initialize.log
StandardError=append:/var/log/daf-osm/global-initialize.log
