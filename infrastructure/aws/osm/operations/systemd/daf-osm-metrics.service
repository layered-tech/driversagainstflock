[Unit]
Description=Publish OSM pipeline health metrics
After=postgresql.service

[Service]
Type=oneshot
User=osm_ingest
Group=osm_ingest
EnvironmentFile=/etc/daf-osm/daf-osm.env
ExecStart=/opt/daf-osm/bin/metrics.sh
TimeoutStartSec=45s
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=append:/var/log/daf-osm/metrics.log
StandardError=append:/var/log/daf-osm/metrics.log
