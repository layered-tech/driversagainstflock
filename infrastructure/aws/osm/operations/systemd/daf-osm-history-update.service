[Unit]
Description=Apply global minute updates to North America ALPR history
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=osm_ingest
Group=osm_ingest
EnvironmentFile=/etc/daf-osm/daf-osm.env
RuntimeDirectory=daf-osm
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/flock --nonblock /run/daf-osm/history.lock /opt/daf-osm/bin/history-update.sh
TimeoutStartSec=50min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=append:/var/log/daf-osm/history-update.log
StandardError=append:/var/log/daf-osm/history-update.log
