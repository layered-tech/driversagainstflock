EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_OPENSTREETMAP_CLIENT_ID=

# Optional OpenStreetMap host override. Defaults when unset: production builds
# use https://www.openstreetmap.org; every other environment uses
# https://api06.dev.openstreetmap.org.
EXPO_PUBLIC_OSM_BASE_URL=

# Set false to disable map rain/snow on phone and car surfaces.
EXPO_PUBLIC_MAP_WEATHER_ENABLED=true

# Optional React Native Firebase web config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_ANALYTICS_ENABLED=1

# Native service files for React Native Firebase.
FIREBASE_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json
FIREBASE_IOS_GOOGLE_SERVICES_FILE=./GoogleService-Info.plist

# Native crash reporting is enabled in release builds, except E2E.
EXPO_PUBLIC_FIREBASE_CRASHLYTICS_ENABLED=1
