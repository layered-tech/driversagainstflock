{
  "name": "driversagainstflock",
  "version": "2.8.4",
  "main": "index.js",
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "expo-file-system",
          "expo-image"
        ]
      }
    }
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "prebuild": "expo prebuild --clean",
    "prebuild:staging": "APP_ENV=staging EXPO_NO_DOTENV=1 npx dotenv -c staging -- expo prebuild --clean",
    "prebuild:production": "APP_ENV=production EXPO_NO_DOTENV=1 npx dotenv -c production -- expo prebuild --clean",
    "build:android:staging": "APP_ENV=staging EXPO_NO_DOTENV=1 npx dotenv -c staging -- ./scripts/eas-local-build.sh -p android --profile staging --no-wait",
    "build:android:e2e": "APP_ENV=e2e EXPO_NO_DOTENV=1 ./scripts/eas-local-build.sh -p android --profile e2e-test --non-interactive --no-wait",
    "build:android:production": "APP_ENV=production EXPO_NO_DOTENV=1 npx dotenv -c production -- ./scripts/eas-local-build.sh -p android --profile production --non-interactive --no-wait",
    "build:ios:production": "APP_ENV=production EXPO_NO_DOTENV=1 npx dotenv -c production -- ./scripts/eas-local-build.sh -p ios --profile production --no-wait",
    "sentry:upload-sourcemaps": "sentry-expo-upload-sourcemaps dist",
    "android": "expo run:android",
    "android:auto": "adb forward tcp:5277 tcp:5277 && \"$ANDROID_HOME/extras/google/auto/desktop-head-unit\" -c ./config/android-auto-dhu.ini",
    "android:no-bundler": "expo run:android --no-bundler",
    "ios": "expo run:ios",
    "ios:no-bundler": "expo run:ios --no-bundler --device",
    "start:metro": "expo start --dev-client",
    "xcodebuild:external": "./scripts/xcodebuild-external.sh",
    "e2e": "./scripts/maestro-test.sh .maestro",
    "e2e:android": "MAESTRO_PLATFORM=android ./scripts/maestro-test.sh .maestro",
    "e2e:android-auto": "./scripts/android-auto-e2e.sh",
    "e2e:ios": "MAESTRO_PLATFORM=ios ./scripts/maestro-test.sh .maestro",
    "e2e-reset": "./scripts/reset-android-location.sh",
    "test": "npm run test:unit",
    "test:unit": "node --test lib/osm/__tests__/*.test.mjs components/information/__tests__/*.test.mjs components/map/__tests__/*.test.mjs components/scorecard/__tests__/*.test.mjs scripts/__tests__/*.test.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-native-fontawesome": "^1.0.0",
    "@gorhom/bottom-sheet": "^5.2.10",
    "@iternio/react-native-auto-play": "^0.4.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "^24.1.0",
    "@react-native-firebase/app": "^24.1.0",
    "@react-navigation/drawer": "^7.9.4",
    "@rnmapbox/maps": "10.3.1",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.11",
    "expo-build-properties": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-glass-effect": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.8",
    "expo-navigation-bar": "~57.0.2",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-speech-recognition": "^56.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.8",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.35.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "private": true,
  "devDependencies": {
    "babel-preset-expo": "^57.0.5",
    "dotenv-cli": "^11.0.0",
    "patch-package": "^8.0.1",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19"
  }
}
