{
    "name": "driversagainstflock",
    "version": "2.9.3",
    "main": "index.js",
    "expo": {
        "autolinking": {
            "android": {
                "buildFromSource": [
                    "expo-location"
                ]
            },
            "ios": {
                "exclude": [
                    "expo-image"
                ]
            }
        }
    },
    "scripts": {
        "start": "expo start",
        "prebuild": "expo prebuild --clean",
        "prebuild:staging": "APP_ENV=staging EXPO_NO_DOTENV=1 npx dotenv -c staging -- expo prebuild --clean",
        "prebuild:production": "APP_ENV=production EXPO_NO_DOTENV=1 npx dotenv -c production -- expo prebuild --clean",
        "build:android:staging": "APP_ENV=staging EXPO_NO_DOTENV=1 npx dotenv -c staging -- ./scripts/eas-local-build.sh -p android --profile staging --no-wait",
        "build:android:watch-staging": "./scripts/build-watch-staging.sh",
        "build:android:e2e": "APP_ENV=e2e EXPO_NO_DOTENV=1 ./scripts/eas-local-build.sh -p android --profile e2e-test --non-interactive --no-wait",
        "build:android:production": "APP_ENV=production EXPO_NO_DOTENV=1 npx dotenv -c production -- ./scripts/eas-local-build.sh -p android --profile production --non-interactive --no-wait",
        "build:ios:production": "APP_ENV=production EXPO_NO_DOTENV=1 npx dotenv -c production -- ./scripts/eas-local-build.sh -p ios --profile production --no-wait",
        "android": "expo run:android",
        "android:auto": "bash ./scripts/android-auto.sh 2.0 landscape",
        "android:auto:2.1": "bash ./scripts/android-auto.sh 2.1 landscape",
        "android:auto:portrait": "bash ./scripts/android-auto.sh 2.0 portrait",
        "android:auto:portrait:2.1": "bash ./scripts/android-auto.sh 2.1 portrait",
        "carplay:gpx": "uv run --no-project --with pymobiledevice3==11.45.0 pymobiledevice3 developer dvt simulate-location play --userspace ./.android-auto/route-pewaukee.gpx",
        "carplay:gps:clear": "uv run --no-project --with pymobiledevice3==11.45.0 pymobiledevice3 developer dvt simulate-location clear --userspace",
        "carplay:screenshot": "node ./scripts/carplay-e2e.mjs --screenshot",
        "android:no-bundler": "expo run:android --no-bundler",
        "ios": "expo run:ios",
        "ios:no-bundler": "expo run:ios --no-bundler --device",
        "start:metro": "expo start --dev-client",
        "xcodebuild:external": "./scripts/xcodebuild-external.sh",
        "e2e": "./scripts/maestro-test.sh .maestro",
        "e2e:android": "MAESTRO_PLATFORM=android ./scripts/maestro-test.sh .maestro",
        "e2e:android-auto": "./scripts/android-auto-e2e.sh",
        "e2e:carplay": "node ./scripts/carplay-e2e.mjs",
        "e2e:carplay:route-choices": "CARPLAY_E2E_SUITE=route-choices node ./scripts/carplay-e2e.mjs",
        "e2e:carplay:ui": "CARPLAY_E2E_SUITE=navigation node ./scripts/carplay-e2e.mjs",
        "e2e:carplay:alpr": "CARPLAY_E2E_SUITE=alpr node ./scripts/carplay-e2e.mjs",
        "e2e:android-auto:portrait": "ANDROID_AUTO_E2E_DHU_BINARY=\"${ANDROID_AUTO_DHU_ROOT:-$HOME/Library/Android/dhu}/2.1/desktop-head-unit\" ./scripts/android-auto-e2e.sh ./.android-auto/suite-portrait.json",
        "e2e:ios": "MAESTRO_PLATFORM=ios ./scripts/maestro-test.sh .maestro",
        "e2e:contribute-tour": "./scripts/maestro-test.sh .maestro/contribute-wizard.yml .maestro/contribute-signed-out.yml .maestro/contribute-tour-skip.yml .maestro/contribute-tour-resume.yml .maestro/contribute-tour-reset.yml",
        "e2e:map-options-tour": "./scripts/maestro-test.sh .maestro/map-options-tour.yml .maestro/map-options-tour-skip.yml",
        "e2e:scorecard-tour": "./scripts/maestro-test.sh .maestro/scorecard-tour.yml .maestro/scorecard-tour-skip.yml",
        "e2e:user-tours": "./scripts/maestro-test.sh .maestro/contribute-wizard.yml .maestro/contribute-signed-out.yml .maestro/contribute-tour-skip.yml .maestro/contribute-tour-resume.yml .maestro/contribute-tour-reset.yml .maestro/map-options-tour.yml .maestro/map-options-tour-skip.yml .maestro/scorecard-tour.yml .maestro/scorecard-tour-skip.yml",
        "e2e-reset": "./scripts/reset-android-location.sh",
        "test": "npm run test:unit",
        "test:unit": "node --test lib/osm/__tests__/*.test.mjs components/design-system/__tests__/*.test.mjs components/information/__tests__/*.test.mjs components/map/__tests__/*.test.mjs components/scorecard/__tests__/*.test.mjs scripts/__tests__/*.test.mjs components/areas/__tests__/*.test.mjs components/watch/__tests__/*.test.mjs",
        "e2e:road-corridor": "MAESTRO_PLATFORM=android EXPO_PUBLIC_E2E_MAP_API_MOCKS=0 EXPO_PUBLIC_E2E_CORRIDOR_PROBE=1 EXPO_PUBLIC_API_BASE_URL=https://staging.driversagainstflock.org/api ./scripts/maestro-test.sh .maestro/live-api/road-corridor-sussex.yml",
        "e2e:android-auto:route-choices": "ANDROID_AUTO_E2E_SUITE=route-choices ./scripts/android-auto-e2e.sh",
        "e2e:android-auto:ui": "ANDROID_AUTO_E2E_SUITE=navigation ./scripts/android-auto-e2e.sh",
        "e2e:android-auto:alpr": "ANDROID_AUTO_E2E_SUITE=alpr ./scripts/android-auto-e2e.sh",
        "e2e:android-auto:route-choices:portrait": "ANDROID_AUTO_E2E_SUITE=route-choices ANDROID_AUTO_E2E_DHU_BINARY=\"${ANDROID_AUTO_DHU_ROOT:-$HOME/Library/Android/dhu}/2.1/desktop-head-unit\" ./scripts/android-auto-e2e.sh ./.android-auto/suite-portrait.json",
        "e2e:android-auto:ui:portrait": "ANDROID_AUTO_E2E_SUITE=navigation ANDROID_AUTO_E2E_DHU_BINARY=\"${ANDROID_AUTO_DHU_ROOT:-$HOME/Library/Android/dhu}/2.1/desktop-head-unit\" ./scripts/android-auto-e2e.sh ./.android-auto/suite-portrait.json"
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/react-native-fontawesome": "^1.0.0",
        "@gorhom/bottom-sheet": "^5.2.14",
        "@iternio/react-native-auto-play": "github:layered-tech/react-native-auto-play#map-button-persistence-package",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-firebase/analytics": "^24.1.1",
        "@react-native-firebase/app": "git+https://github.com/layered-tech/react-native-firebase.git#e7b068897da77256a99d1e01c3788f8d755848ce",
        "@react-native-firebase/crashlytics": "24.1.1",
        "@react-navigation/drawer": "^7.14.3",
        "@rnmapbox/maps": "git+https://github.com/layered-tech/maps.git#6051867f2ea13037a4e32aea166daba7c3bdf651",
        "expo": "~58.0.20",
        "expo-build-properties": "~58.0.11",
        "expo-constants": "~58.0.13",
        "expo-crypto": "~58.0.7",
        "expo-dev-client": "~58.0.15",
        "expo-file-system": "~58.0.11",
        "expo-font": "~58.0.10",
        "expo-glass-effect": "~58.0.5",
        "expo-keep-awake": "~58.0.3",
        "expo-linking": "~58.0.14",
        "expo-location": "~58.0.19",
        "expo-navigation-bar": "~58.0.4",
        "expo-notifications": "~58.1.6",
        "expo-router": "~58.0.26",
        "expo-secure-store": "~58.0.2",
        "expo-speech-recognition": "^56.0.4",
        "expo-status-bar": "~58.0.4",
        "expo-symbols": "~58.0.4",
        "expo-system-ui": "~58.0.6",
        "expo-task-manager": "~58.0.12",
        "expo-web-browser": "~58.0.6",
        "fflate": "^0.8.3",
        "nativewind": "^4.2.7",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.0",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-nitro-modules": "0.37.1",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-svg": "15.16.0",
        "react-native-worklets": "0.13.0"
    },
    "overrides": {
        "image-size": "^2.0.3",
        "decode-uri-component": "^0.5.0",
        "@grpc/grpc-js": "^1.13.6",
        "uuid": "^11.1.1"
    },
    "private": true,
    "devDependencies": {
        "babel-preset-expo": "~58.0.0",
        "dotenv-cli": "^11.0.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^3.4.19"
    }
}
