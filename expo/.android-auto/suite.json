{
    "name": "Android Auto end-to-end",
    "appId": "com.anonymous.drivefree.dev",
    "serviceComponent": "com.anonymous.drivefree.dev/com.margelo.nitro.swe.iternio.reactnativeautoplay.AndroidAutoService",
    "display": {
        "width": 1280,
        "height": 720
    },
    "metro": {
        "host": "10.0.2.2",
        "port": 8091
    },
    "location": {
        "latitude": 43.12152,
        "longitude": -88.24447
    },
    "tests": [
        {
            "name": "connects and renders the Mapbox map",
            "steps": [
                {
                    "type": "replayRoute",
                    "file": "route-pewaukee.json",
                    "fromMs": 0,
                    "toMs": 4000
                },
                {
                    "type": "carLayout",
                    "layout": "dashboard"
                },
                {
                    "type": "tapMap"
                },
                {
                    "type": "sleep",
                    "milliseconds": 2500
                },
                {
                    "type": "screenshot",
                    "name": "connected-map"
                },
                {
                    "type": "assertPuckVisible",
                    "screenshot": "connected-map"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "connected-map",
                    "contains": ["SPEED", "LIMIT"]
                },
                {
                    "type": "assertService",
                    "running": true
                }
            ],
            "layout": "dashboard"
        },
        {
            "name": "switches between day and night presentation",
            "steps": [
                {
                    "type": "dhu",
                    "command": "day"
                },
                {
                    "type": "sleep",
                    "milliseconds": 1500
                },
                {
                    "type": "screenshot",
                    "name": "day-mode",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "dhu",
                    "command": "night",
                    "waitForMetro": "[Android Auto] map-preset-night"
                },
                {
                    "type": "sleep",
                    "milliseconds": 2500
                },
                {
                    "type": "screenshot",
                    "name": "night-mode",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertMapThemeContrast",
                    "day": "day-mode",
                    "night": "night-mode",
                    "recapture": "night-mode"
                },
                {
                    "type": "dhu",
                    "command": "day",
                    "waitForMetro": "[Android Auto] map-preset-day"
                },
                {
                    "type": "sleep",
                    "milliseconds": 2500
                },
                {
                    "type": "screenshot",
                    "name": "day-mode-return",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertMapThemeContrast",
                    "day": "day-mode-return",
                    "night": "night-mode",
                    "recapture": "day-mode-return"
                }
            ],
            "layout": "dashboard"
        },
        {
            "name": "warns about an upcoming mapped ALPR along the saved road",
            "steps": [
                {
                    "type": "replayRoute",
                    "file": "route-pewaukee.json",
                    "fromMs": 4000,
                    "toMs": 8000
                },
                {
                    "type": "resetLiveGpsDrive"
                },
                {
                    "type": "replayRoute",
                    "file": "route-pewaukee.json",
                    "fromMs": 8000,
                    "toMs": 15000
                },
                {
                    "type": "screenshot",
                    "name": "saved-route-upcoming",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertPuckVisible",
                    "screenshot": "saved-route-upcoming"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "saved-route-upcoming",
                    "contains": ["ALPR"],
                    "notContains": ["Camera you just passed"]
                }
            ],
            "layout": "dashboard"
        },
        {
            "name": "confirms the camera after an actual GPS pass",
            "steps": [
                {
                    "type": "replayRoute",
                    "file": "route-pewaukee.json",
                    "fromMs": 15000,
                    "toMs": 78000
                },
                {
                    "type": "screenshot",
                    "name": "saved-route-confirmation",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertOcr",
                    "screenshot": "saved-route-confirmation",
                    "contains": [
                        "Camera you just passed",
                        "Not there",
                        "Dismiss"
                    ],
                    "notContains": ["SPEED", "LIMIT"]
                }
            ],
            "layout": "dashboard"
        },
        {
            "name": "expires confirmation and restores map status while continuing the drive",
            "steps": [
                {
                    "type": "replayRoute",
                    "file": "route-pewaukee.json",
                    "fromMs": 78000,
                    "toMs": 108000,
                    "cameraStability": {
                        "fromMs": 80000,
                        "toMs": 90000,
                        "intervalMs": 2000
                    }
                },
                {
                    "type": "assertConfirmationCameraStable",
                    "screenshot": "saved-route-confirmation"
                },
                {
                    "type": "screenshot",
                    "name": "saved-route-restored",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertPuckVisible",
                    "screenshot": "saved-route-restored"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "saved-route-restored",
                    "contains": ["SPEED", "LIMIT"],
                    "notContains": ["Camera you just passed"]
                }
            ],
            "layout": "dashboard"
        },
        {
            "name": "continues the saved GPS route while the phone sleeps",
            "steps": [
                {
                    "type": "phoneSleep"
                },
                {
                    "type": "screenshot",
                    "name": "phone-asleep-before-progress",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertPuckVisible",
                    "screenshot": "phone-asleep-before-progress"
                },
                {
                    "type": "replayRoute",
                    "file": "route-pewaukee.json",
                    "fromMs": 108000,
                    "toMs": 147000
                },
                {
                    "type": "screenshot",
                    "name": "phone-asleep",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertPuckVisible",
                    "screenshot": "phone-asleep"
                },
                {
                    "type": "assertMapCropsDiffer",
                    "first": "phone-asleep-before-progress",
                    "second": "phone-asleep"
                },
                {
                    "type": "assertService",
                    "running": true
                },
                {
                    "type": "phoneWake"
                }
            ],
            "layout": "dashboard"
        },
        {
            "name": "Dashboard: Still there / Dismiss restores follow without reporting",
            "layout": "dashboard",
            "steps": [
                {
                    "type": "carLayout",
                    "layout": "dashboard"
                },
                {
                    "type": "replayRoute",
                    "file": "route-pewaukee.json",
                    "fromMs": 45000,
                    "toMs": 47000
                },
                {
                    "type": "resetLiveGpsDrive"
                },
                {
                    "type": "replayRoute",
                    "file": "route-pewaukee.json",
                    "fromMs": 47000,
                    "toMs": 78000
                },
                {
                    "type": "screenshot",
                    "name": "dashboard-dismiss-confirmation",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertOcr",
                    "screenshot": "dashboard-dismiss-confirmation",
                    "contains": [
                        "Camera you just passed",
                        "Still there",
                        "Dismiss",
                        "Not there"
                    ]
                },
                {
                    "type": "tapOcr",
                    "screenshot": "dashboard-dismiss-confirmation",
                    "text": "Dismiss",
                    "waitForMetro": "[E2E] presence:native-primary-pressed"
                },
                {
                    "type": "sleep",
                    "milliseconds": 500
                },
                {
                    "type": "screenshot",
                    "name": "dashboard-dismiss-restored",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertOcr",
                    "screenshot": "dashboard-dismiss-restored",
                    "contains": ["SPEED", "LIMIT"],
                    "notContains": ["Camera you just passed", "Thanks"]
                },
                {
                    "type": "assertPuckVisible",
                    "screenshot": "dashboard-dismiss-restored"
                },
                {
                    "type": "assertPresenceReports",
                    "count": 0,
                    "osmNodeId": 12634608635
                }
            ]
        },
        {
            "name": "Dashboard: Not there queues one report and Ok closes Thanks",
            "layout": "dashboard",
            "steps": [
                {
                    "type": "carLayout",
                    "layout": "dashboard"
                },
                {
                    "type": "replayRoute",
                    "file": "route-pewaukee.json",
                    "fromMs": 45000,
                    "toMs": 47000
                },
                {
                    "type": "resetLiveGpsDrive"
                },
                {
                    "type": "replayRoute",
                    "file": "route-pewaukee.json",
                    "fromMs": 47000,
                    "toMs": 78000
                },
                {
                    "type": "screenshot",
                    "name": "dashboard-not-there-confirmation",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertOcr",
                    "screenshot": "dashboard-not-there-confirmation",
                    "contains": [
                        "Camera you just passed",
                        "Still there",
                        "Dismiss",
                        "Not there"
                    ]
                },
                {
                    "type": "tapOcr",
                    "screenshot": "dashboard-not-there-confirmation",
                    "text": "Not there",
                    "waitForMetro": "[E2E] presence:native-not-there-pressed",
                    "waitForPresentation": "[E2E] presence:native-thanks-presented"
                },
                {
                    "type": "sleep",
                    "milliseconds": 500
                },
                {
                    "type": "screenshot",
                    "name": "dashboard-not-there-thanks"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "dashboard-not-there-thanks",
                    "contains": ["Thanks", "Ok"],
                    "retryDelayMilliseconds": 250,
                    "timeout": 3000,
                    "notContains": ["Camera you just passed"]
                },
                {
                    "type": "assertPresenceReports",
                    "count": 1,
                    "osmNodeId": 12634608635
                },
                {
                    "type": "tapOcr",
                    "screenshot": "dashboard-not-there-thanks",
                    "text": "Ok",
                    "waitForMetro": "[E2E] presence:native-thanks-ok-pressed"
                },
                {
                    "type": "sleep",
                    "milliseconds": 500
                },
                {
                    "type": "screenshot",
                    "name": "dashboard-not-there-restored",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertOcr",
                    "screenshot": "dashboard-not-there-restored",
                    "contains": ["SPEED", "LIMIT"],
                    "notContains": ["Camera you just passed", "Thanks"]
                },
                {
                    "type": "assertPuckVisible",
                    "screenshot": "dashboard-not-there-restored"
                },
                {
                    "type": "assertPresenceReports",
                    "count": 1,
                    "osmNodeId": 12634608635
                }
            ]
        },
