{
    "name": "Android Auto end-to-end",
    "appId": "com.anonymous.drivefree.dev",
    "serviceComponent": "com.anonymous.drivefree.dev/com.margelo.nitro.swe.iternio.reactnativeautoplay.AndroidAutoService",
    "display": {
        "width": 1280,
        "height": 720
    },
    "metro": {
        "host": "10.0.2.2",
        "port": 8091
    },
    "location": {
        "latitude": 30.2672,
        "longitude": -97.7431
    },
    "tests": [
        {
            "name": "connects and renders the Mapbox map",
            "steps": [
                {
                    "type": "dhu",
                    "command": "tap 400 300"
                },
                {
                    "type": "sleep",
                    "milliseconds": 2500
                },
                {
                    "type": "screenshot",
                    "name": "connected-map"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "connected-map",
                    "contains": ["Congress Avenue", "SPEED", "LIMIT"]
                },
                {
                    "type": "assertService",
                    "running": true
                }
            ]
        },
        {
            "name": "records a route-free crossing on the phone Scorecard",
            "steps": [
                {
                    "type": "scorecardDriveScenario",
                    "scenario": "automotive-free-exposure"
                },
                {
                    "type": "geoFix",
                    "latitude": 30.266264,
                    "longitude": -97.7479
                },
                {
                    "type": "waitForScorecardCameraInventory"
                },
                {
                    "type": "geoFix",
                    "latitude": 30.266264,
                    "longitude": -97.74735
                },
                {
                    "type": "assertPhoneScorecardCrossings",
                    "count": 1
                },
                {
                    "type": "assertWakeLock",
                    "held": true
                }
            ]
        },
        {
            "name": "switches between day and night presentation",
            "steps": [
                {
                    "type": "dhu",
                    "command": "day"
                },
                {
                    "type": "sleep",
                    "milliseconds": 1500
                },
                {
                    "type": "screenshot",
                    "name": "day-mode",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "dhu",
                    "command": "night",
                    "waitForMetro": "[Android Auto] map-preset-night"
                },
                {
                    "type": "sleep",
                    "milliseconds": 2500
                },
                {
                    "type": "screenshot",
                    "name": "night-mode",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertMapThemeContrast",
                    "day": "day-mode",
                    "night": "night-mode",
                    "recapture": "night-mode"
                },
                {
                    "type": "dhu",
                    "command": "day",
                    "waitForMetro": "[Android Auto] map-preset-day"
                },
                {
                    "type": "sleep",
                    "milliseconds": 2500
                },
                {
                    "type": "screenshot",
                    "name": "day-mode-return",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertMapThemeContrast",
                    "day": "day-mode-return",
                    "night": "night-mode",
                    "recapture": "day-mode-return"
                }
            ]
        },
        {
            "name": "shows native Android Auto search results",
            "steps": [
                {
                    "type": "deepLink",
                    "requestType": "search",
                    "query": "Walmart"
                },
                {
                    "type": "sleep",
                    "milliseconds": 5000
                },
                {
                    "type": "screenshot",
                    "name": "search-results"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "search-results",
                    "contains": [
                        "Search results",
                        "Walmart Supercenter",
                        "Walmart Neighborhood",
                        "2525 W Anderson Ln"
                    ]
                },
                {
                    "type": "dhu",
                    "command": "keycode back"
                },
                {
                    "type": "sleep",
                    "milliseconds": 1500
                }
            ]
        },
        {
            "name": "offers two route choices and starts private guidance",
            "steps": [
                {
                    "type": "deepLink",
                    "requestType": "directions",
                    "query": "Austin Central Library"
                },
                {
                    "type": "sleep",
                    "milliseconds": 7000
                },
                {
                    "type": "screenshot",
                    "name": "route-choices"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "route-choices",
                    "contains": [
                        "Austin Central Library",
                        "Private route",
                        "3 monitored nodes",
                        "Start"
                    ]
                },
                {
                    "type": "dhu",
                    "command": "tap 250 390"
                },
                {
                    "type": "sleep",
                    "milliseconds": 5000
                },
                {
                    "type": "screenshot",
                    "name": "navigation-started"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "navigation-started",
                    "contains": [
                        "Turn right to avoid",
                        "monitored intersections"
                    ]
                }
            ]
        },
        {
            "name": "toggles between 3D follow and route overview",
            "steps": [
                {
                    "type": "screenshot",
                    "name": "map-view-perspective-before",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "dhu",
                    "command": "tap 600 300; sleep 1; tap 730 55",
                    "waitForMetro": "[Auto Play] driving-route-overview-fitted",
                    "timeout": 15000
                },
                {
                    "type": "sleep",
                    "milliseconds": 1500
                },
                {
                    "type": "screenshot",
                    "name": "map-view-route-overview",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertOcr",
                    "screenshot": "map-view-route-overview",
                    "contains": ["Arrive at your destin"],
                    "notContains": ["SPEED", "LIMIT", "Congress Avenue"]
                },
                {
                    "type": "assertMapCropsDiffer",
                    "first": "map-view-perspective-before",
                    "second": "map-view-route-overview"
                },
                {
                    "type": "dhu",
                    "command": "tap 600 300; sleep 1; tap 730 55",
                    "waitForMetro": "[Auto Play] driving-map-view-perspective-restored",
                    "timeout": 15000
                },
                {
                    "type": "sleep",
                    "milliseconds": 1500
                },
                {
                    "type": "screenshot",
                    "name": "map-view-perspective-after",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertOcr",
                    "screenshot": "map-view-perspective-after",
                    "contains": ["Arrive at your destin", "SPEED", "LIMIT"]
                },
                {
                    "type": "assertMapCropsDiffer",
                    "first": "map-view-route-overview",
                    "second": "map-view-perspective-after"
                }
            ]
        },
        {
            "name": "renders active guidance map themes",
            "steps": [
                {
                    "type": "dhu",
                    "command": "day"
                },
                {
                    "type": "sleep",
                    "milliseconds": 1500
                },
                {
                    "type": "screenshot",
                    "name": "active-guidance-day",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "dhu",
                    "command": "night",
                    "waitForMetro": "[Android Auto] map-preset-night"
                },
                {
                    "type": "sleep",
                    "milliseconds": 2500
                },
                {
                    "type": "screenshot",
                    "name": "active-guidance-night",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertMapThemeContrast",
                    "day": "active-guidance-day",
                    "night": "active-guidance-night",
                    "recapture": "active-guidance-night"
                },
                {
                    "type": "dhu",
                    "command": "day",
                    "waitForMetro": "[Android Auto] map-preset-day"
                },
                {
                    "type": "sleep",
                    "milliseconds": 2500
                },
                {
                    "type": "screenshot",
                    "name": "active-guidance-day-return",
                    "requireVisibleMapCrop": true
                },
                {
                    "type": "assertMapThemeContrast",
                    "day": "active-guidance-day-return",
                    "night": "active-guidance-night",
                    "recapture": "active-guidance-day-return"
                }
            ]
        },
        {
            "name": "advances guidance while the phone sleeps",
            "steps": [
                {
                    "type": "phoneSleep"
                },
                {
                    "type": "screenshot",
                    "name": "phone-asleep-before-progress"
                },
                {
                    "type": "autoDrive",
                    "waitForMetro": "[Android Auto] auto-drive-progressed",
                    "timeout": 15000
                },
                {
                    "type": "sleep",
                    "milliseconds": 9000
                },
                {
                    "type": "screenshot",
                    "name": "phone-asleep"
                },
                {
                    "type": "assertImagesDiffer",
                    "first": "phone-asleep-before-progress",
                    "second": "phone-asleep"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "phone-asleep",
                    "contains": [
                        "Arrive at your destin",
                        "Austin Central Library"
                    ]
                },
                {
                    "type": "phoneWake"
                }
            ]
        },
        {
            "name": "handles the Android Auto host stop action",
            "steps": [
                {
                    "type": "dhu",
                    "command": "tap 145 665",
                    "waitForMetro": "[Android Auto] host-navigation-stopped"
                },
                {
                    "type": "sleep",
                    "milliseconds": 4000
                },
                {
                    "type": "screenshot",
                    "name": "host-stopped-navigation"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "host-stopped-navigation",
                    "contains": ["SPEED", "LIMIT", "Congress Avenue"],
                    "notContains": [
                        "Turn right to avoid monitored intersections",
                        "Arrive at your destination"
                    ]
                },
                {
                    "type": "assertService",
                    "running": true
                }
            ]
        },
        {
            "name": "stops the Android Auto service on disconnect",
            "steps": [
                {
                    "type": "disconnect"
                },
                {
                    "type": "assertService",
                    "running": false
                }
            ]
        }
    ]
}
