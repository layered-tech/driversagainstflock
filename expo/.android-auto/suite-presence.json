{
    "name": "CHR-7 presence smoke",
    "appId": "com.anonymous.drivefree.dev",
    "serviceComponent": "com.anonymous.drivefree.dev/com.margelo.nitro.swe.iternio.reactnativeautoplay.AndroidAutoService",
    "display": {
        "width": 1280,
        "height": 720
    },
    "metro": {
        "host": "10.0.2.2",
        "port": 8091
    },
    "location": {
        "latitude": 30.2672,
        "longitude": -97.7431
    },
    "tests": [
        {
            "name": "connects and renders the Mapbox map",
            "steps": [
                {
                    "type": "dhu",
                    "command": "tap 400 300"
                },
                {
                    "type": "sleep",
                    "milliseconds": 2500
                },
                {
                    "type": "screenshot",
                    "name": "connected-map"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "connected-map",
                    "contains": ["Congress Avenue", "SPEED", "LIMIT"]
                },
                {
                    "type": "assertService",
                    "running": true
                }
            ]
        },
        {
            "name": "recently passed confirmation expires and restores map",
            "steps": [
                {
                    "type": "deepLink",
                    "requestType": "presence",
                    "query": "start"
                },
                {
                    "type": "sleep",
                    "milliseconds": 11500
                },
                {
                    "type": "screenshot",
                    "name": "presence-visible"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "presence-visible",
                    "contains": [
                        "Camera you just passed",
                        "Still there",
                        "Dismiss",
                        "Not there"
                    ]
                },
                {
                    "type": "sleep",
                    "milliseconds": 21000
                },
                {
                    "type": "screenshot",
                    "name": "presence-expired"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "presence-expired",
                    "notContains": ["Camera you just passed"]
                }
            ]
        },
        {
            "name": "native negative action queues one report and restores map",
            "steps": [
                {
                    "type": "deepLink",
                    "requestType": "presence",
                    "query": "reset"
                },
                {
                    "type": "deepLink",
                    "requestType": "presence",
                    "query": "start"
                },
                {
                    "type": "sleep",
                    "milliseconds": 11500
                },
                {
                    "type": "screenshot",
                    "name": "presence-before-report"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "presence-before-report",
                    "contains": ["Camera you just passed", "Not there"]
                },
                {
                    "type": "dhu",
                    "command": "tap 275 225",
                    "waitForMetro": "[ALPR presence] Report queued"
                },
                {
                    "type": "sleep",
                    "milliseconds": 800
                },
                {
                    "type": "screenshot",
                    "name": "presence-reported"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "presence-reported",
                    "notContains": ["Camera you just passed"]
                }
            ]
        },
        {
            "name": "former speed and road gates do not block native confirmation",
            "steps": [
                {
                    "type": "deepLink",
                    "requestType": "presence",
                    "query": "reset"
                },
                {
                    "type": "deepLink",
                    "requestType": "presence",
                    "query": "former-eligibility"
                },
                {
                    "type": "sleep",
                    "milliseconds": 11500
                },
                {
                    "type": "screenshot",
                    "name": "presence-former-gates"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "presence-former-gates",
                    "contains": ["Camera you just passed", "Still there"]
                },
                {
                    "type": "dhu",
                    "command": "tap 275 154",
                    "waitForMetro": "[E2E] presence:native-dismissed:user"
                }
            ]
        },
        {
            "name": "active navigation permits a clear maneuver window",
            "steps": [
                {
                    "type": "deepLink",
                    "requestType": "presence",
                    "query": "reset"
                },
                {
                    "type": "deepLink",
                    "requestType": "presence",
                    "query": "navigation"
                },
                {
                    "type": "sleep",
                    "milliseconds": 11500
                },
                {
                    "type": "screenshot",
                    "name": "presence-navigation-clear"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "presence-navigation-clear",
                    "contains": ["Camera you just passed", "Not there"]
                },
                {
                    "type": "dhu",
                    "command": "tap 275 154",
                    "waitForMetro": "[E2E] presence:native-dismissed:user"
                }
            ]
        },
        {
            "name": "active navigation blocks confirmation near a maneuver",
            "steps": [
                {
                    "type": "deepLink",
                    "requestType": "presence",
                    "query": "reset"
                },
                {
                    "type": "deepLink",
                    "requestType": "presence",
                    "query": "navigation-near-maneuver"
                },
                {
                    "type": "sleep",
                    "milliseconds": 20000
                },
                {
                    "type": "screenshot",
                    "name": "presence-navigation-blocked"
                },
                {
                    "type": "assertOcr",
                    "screenshot": "presence-navigation-blocked",
                    "notContains": ["Camera you just passed"]
                }
            ]
        },
        {
            "name": "disconnect",
            "steps": [
                {
                    "type": "disconnect"
                },
                {
                    "type": "assertService",
                    "running": false
                }
            ]
        }
    ]
}
